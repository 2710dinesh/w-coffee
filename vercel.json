{
  "services": {
    "w-coffee": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "w-coffee"
      }
    }
  ]
}
